package com.kh.model.service;

import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.kh.model.dto.CatDto;
import com.kh.model.vo.Cat;

public class CatService {
	private List<Cat> cats = new ArrayList<Cat>();
	private int catId;
	
	{ // 뭉치 21.6.25
		cats.add(new Cat(++catId, "아토", "갈색 태비", 3.5, "개냥이", "2020-03-08"));
		cats.add(new Cat(++catId, "뭉치", "회색 태비", 5.0, "개냥이", "2021-06-25"));
	}
	
	public void createCat(CatDto cat) {
		cats.add(new Cat(++catId, cat.getName(), cat.getColor(), cat.getWeight(), cat.getPersonality(),
				 new SimpleDateFormat("yyyy-MM-dd").format(new Date())));
	}
	
	public List<Cat> findAll(){
		return cats;
	}
	
	public Cat findById(int catNum) {
		for(Cat cat : cats) {
			if(cat.getCatId() == catNum) {
				return cat;
			}
		}
		return null;
	}
	
	public Cat updateCat(int catNum, CatDto cat) {
		int index = 0;
		for(int i = 0; i < cats.size(); i++) {
			if(cats.get(i).getCatId() == catNum) {
				index = 1
			}
			Cat c = cats.get(i);
			cats.set(i, new Cat(catNum, cat.getName(), cat.getColor(),
					cat.getWeight(), cat.getPersonality(), c.getBirth()));
			return cats.get(i);
		}
		return null;
	}
	
	public int deleteCat(int catNum) {
		if(catNum < 0) {
			return 0;
		}
		int catNo = -1;
		for(int i = 0; i < cats.size(); i++) {
			if(cats.get(i).getCatId() == catNum) {
				catNo = i;
				break;
			}
		}
		if(catNo > -1) {
			cats.remove(catNo);
			return 1;
		}
		return 0;
	}
}
