package com.kh.model.dto;

public class CatDto {
	private int catId;
	private String name;
	private String color;
	private String weight;
	private String personality;
	private String birth;
	public CatDto(int catId, String name, String color, String weight, String personality, String birth) {
		this.catId = catId;
		this.name = name;
		this.color = color;
		this.weight = weight;
		this.personality = personality;
		this.birth = birth;
	}
	
}
