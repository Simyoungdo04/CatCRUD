	private void findAll() {
		if(cats.isEmpty()) {
			System.out.println();
			System.out.println("고양이가 존재하지 않습니다.");
		} else {
			System.out.println();
			System.out.println("고양이들 : ");
			System.out.println();
			for(Cat cat : cats) {
				System.out.println("ID : " + cat.getCatId() + "\t| 이름 : " + cat.getName() + "  | 색깔 : " + 
			                       cat.getColor() + "  | 몸무게 : " + cat.getWeight() + "  | 성격 : " + 
								   cat.getPersonality() + "  | 생일 : " + cat.getBirth());
				System.out.println();
			}
		}
	}
	
	private void findById() {
		if(cats.isEmpty()) {
			System.out.println();
			System.out.println("고양이가 존재하지 않습니다.");
		}
		findAll();
		int catNum = 0;
		int selected = 0;
		while(selected != 1) {
			System.out.println();
			System.out.print("조회하고 싶은 고양이의 ID를 입력해주세요 > ");
			try {
				catNum = sc.nextInt();
				sc.nextLine();
				selected = 1;
			} catch(InputMismatchException e) {
				System.out.println("ID는 숫자만 입력할 수 있습니다.");
				sc.nextLine();
			}
		}
		Cat cat = cc.findById(catNum);
		
		if(cat != null) {
			System.out.println();
			System.out.println("=========<고양이 정보>=========");
			System.out.println("ID : " + cat.getCatId());
			System.out.println("이름 : " + cat.getName());
			System.out.println("색깔 : " + cat.getColor());
			System.out.println("몸무게 : " + cat.getWeight());
			System.out.println("성격 : " + cat.getPersonality());
			System.out.println("생일 : " + cat.getBirth());
			System.out.println("=============================");
		} else {
			System.out.println("고양이를 찾을 수가 없습니다.");
			System.out.println();
		}
	}
	
	public void updateCat() {
		if(cats.isEmpty()) {
			System.out.println();
			System.out.println("고양이가 존재하지 않습니다.");
		}
		findAll();
		int catNum = 0;
		int selected = 0;
		while(selected != 1) {
			System.out.println();
			System.out.print("정보를 수정할 고양이의 ID를 입력해주세요 > ");
			try {
				catNum = sc.nextInt();
				sc.nextLine();
				selected = 1;
			} catch(InputMismatchException e) {
				System.out.println("ID는 숫자만 입력할 수 있습니다.");
				sc.nextLine();
			}
		}
		// Cat cat = cc.updateCat(catNum);
		Cat c = cc.findById(catNum);
		
		if(c != null) {
			System.out.println();
			System.out.print("고양이의 이름을 입력해주세요 > ");
			String name = sc.nextLine();
			System.out.print("고양이의 색깔을 입력해주세요 > ");
			String color = sc.nextLine();
			double weight = 0;
			selected = 0;
			while(selected != 1) {
				System.out.print("고양이의 몸무계를 입력해주세요 > "); 
				try {
					weight = sc.nextDouble();
					sc.nextLine();
					selected = 1;
				} catch(InputMismatchException e) {
					System.out.println("몸무게는 정수 또는 실수만 입력해주세요");
					sc.nextLine();
				}
			}
			System.out.print("고양이의 성격을 입력해주세요 > ");
			String personality = sc.nextLine();
			
			Cat cat = cc.updateCat(catNum, new CatDto(name, color, weight, personality));
			
			if(cat != null) {
				System.out.println();
				System.out.println("=========<고양이 정보>=========");
				System.out.println("ID : " + cat.getCatId());
				System.out.println("이름 : " + cat.getName());
				System.out.println("색깔 : " + cat.getColor());
				System.out.println("몸무게 : " + cat.getWeight());
				System.out.println("성격 : " + cat.getPersonality());
				System.out.println("생일 : " + cat.getBirth());
				System.out.println("=============================");
			} else {
				System.out.println("고양이를 찾을 수가 없습니다.");
				System.out.println();
			}
		} else {
			System.out.println("고양이를 찾을 수가 없습니다.");
			System.out.println();
		}
	}

	private void deleteCat() {
		if(cats.isEmpty()) {
			System.out.println();
			System.out.println("고양이가 존재하지 않습니다.");
		}
		findAll();
		int catNum = 0;
		int selected = 0;
		while(selected != 1) {
			System.out.println();
			System.out.print("삭제시킬 고양이의 ID를 입력해주세요 > ");
			try {
				catNum = sc.nextInt();
				sc.nextLine();
				selected = 1;
			} catch(InputMismatchException e) {
				System.out.println("ID는 숫자만 입력할 수 있습니다.");
				sc.nextLine();
			}
		}
		int deleted = cc.deleteCat(catNum);
		
		if(deleted > 0) {
			System.out.println("고양이 삭제에 성공했습니다.");
		} else {
			System.out.println("고양이 삭제에 실패했습니다.");
		}
	}
}
