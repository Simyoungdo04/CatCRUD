<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-config.dtd">
  
<configuration>

 	<settings>
		<setting name="mapUnderscoreToCamelCase" value="true"/>
	</settings>
  
 	<typeAliases>
  		<typeAlias type="com.kh.cat.model.dto.Cat" alias="cat"/>
  		<typeAlias type="com.kh.cat.model.dto.CatKeeper" alias="catKeeper"/>
  	</typeAliases>
  
    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="oracle.jdbc.driver.OracleDriver"/>
                <property name="url" value="jdbc:oracle:thin:@127.0.0.1:1521:XE"/>
                <property name="username" value="C##YD"/>
                <property name="password" value="YD"/>
            </dataSource>
        </environment>
    </environments>
    
    <mappers>
    		<mapper resource="cat-mapper.xml"/>
    		<mapper resource="catKeeper-mapper.xml"/>
    </mappers>
    
</configuration>